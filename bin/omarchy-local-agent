#!/usr/bin/env python3
"""Local, offline Omarchy assistant.

Two retrieval paths, chosen by what the question actually is:

  FAST   "what's the keybind for X", "which command does Y"
         BM25 over the binds/commands tables answers directly. The card IS the
         answer, so no model runs. Sub-second, and it cannot hallucinate a
         keybinding that does not exist on this machine.

  PROSE  "how do I ...", "why does ..."
         PageIndex: the model reads a cached outline of the manual, names one
         section, we hand back that section verbatim, it answers from that.
         Two calls, the first nearly free because the prefix is cached.

No network at query time. The index is built by omarchy-local-agent-index.
"""

import argparse
import json
import os
import re
import sqlite3
import sys
import textwrap
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, ".local/share/omarchy-local-agent")
DB = os.path.join(ROOT, "index.db")
TOC = os.path.join(ROOT, "toc.json")
CONFIG = os.path.join(HOME, ".config/omarchy-local-agent/config.json")

DEFAULTS = {
    "server": "http://127.0.0.1:8080",
    "timeout": 180,
    # Injection budget in characters. Derived from measured prefill speed by
    # the bake-off, not guessed: cap = target_ttft_seconds * pp_tokens_per_sec.
    "max_inject_chars": 4000,
    # BM25 scores are negative; lower is a better match. A fast-path hit must
    # be at least this good, and must beat the best manual section by this
    # margin, before we answer without consulting the manual at all.
    # Tuned against eval.py's CASES; see README. Overridden by config.json.
    "fast_path_max_score": -6.0,
    "fast_path_margin": 1.0,
    "temperature": 0.2,
    "max_tokens": 400,
    "general_max_tokens": 900,
}

ANSI = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if ANSI else text


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            cfg.update(json.load(fh))
    except (OSError, json.JSONDecodeError):
        pass
    return cfg


# --------------------------------------------------------------------------
# retrieval
# --------------------------------------------------------------------------

STOPWORDS = {
    "how", "do", "i", "the", "a", "an", "to", "in", "on", "my", "is", "what",
    "whats", "for", "of", "can", "does", "with", "and", "it", "me", "you",
    "please", "get", "make", "use", "using", "when", "where", "which", "that",
    # Intent markers. classify() reads these off the raw query; leaving them in
    # the search actively hurts, because "command to update omarchy" then ranks
    # routes whose summary says "command" above `omarchy update` itself.
    "command", "commands", "keybind", "keybinds", "keybinding", "keybindings",
    "hotkey", "hotkeys", "shortcut", "shortcuts", "key", "keys", "bind",
    "binding", "bound", "press",
}

# "omarchy" prefixes every command route, so it carries no signal there and
# skews short-field scoring. It stays meaningful elsewhere, though -- the bind
# described "Omarchy menu" is found by exactly that word.
TABLE_STOPWORDS = {"commands": {"omarchy"}}


def terms(query, table=None):
    """FTS5 MATCH is a query language, so raw user input cannot go in. Reduce to
    bare word tokens and quote each one."""
    drop = STOPWORDS | TABLE_STOPWORDS.get(table, set())
    words = re.findall(r"[A-Za-z0-9_.+-]+", query.lower())
    kept = [w for w in words if w not in drop and len(w) > 1]
    return kept or words


def match_expr(query, table=None, prefix=False):
    """Build an FTS5 MATCH expression.

    prefix=True is for live search, where the user is mid-word: the last token
    becomes a prefix query so "night" finds "nightlight" on the fifth keystroke
    rather than only once the whole word is typed.
    """
    t = terms(query, table)
    if not t:
        return None
    parts = [f'"{w}"' for w in t[:-1]]
    parts.append(f'"{t[-1]}"*' if prefix else f'"{t[-1]}"')
    return " OR ".join(parts)


# BM25 scores are negative (lower = better), so a positive penalty demotes and a
# negative bonus promotes. Both are small on purpose: a clearly better section
# should still win on its own merits.
SKILL_DOC_PENALTY = 2.0

# There is deliberately no "overview section" bonus here. 23 of 51 manual
# chapters have no "##" headings and become one long section that BM25 length
# normalisation buries, so promoting them looked obviously right. Measured, it
# was not: at the magnitude that helped the held-out set (+1 case) it pushed
# whole-chapter overviews from 33% to 80% of all candidate slots and regressed
# a case that had been passing. The real fix for that symptom turned out to be
# the wider fetch pool below. Left documented so it is not "fixed" again.


def dedupe_by_chapter(sections):
    """Keep only each chapter's best-scoring section.

    Without this the candidate slate collapses: `46-faq` alone took two of three
    slots on several queries, because its many short entries win on BM25 length
    normalisation and crowd out the chapter that actually answers. PageIndex
    navigation wants a diverse slate of chapters to choose between, not three
    views of the same one.
    """
    seen, out = set(), []
    for s in sections:
        chapter = s["sid"].split("#")[0]
        if chapter in seen:
            continue
        seen.add(chapter)
        out.append(s)
    return out

# One weight per column, in declared order. A hit in a heading says far more
# about relevance than the same word buried in body prose.
WEIGHTS = {
    #          keys desc dispatcher
    "binds":    (3.0, 8.0, 1.0),
    #          route summary args examples grp
    #  examples are demoted hard: they quote theme names, paths and sample
    #  arguments, so `omarchy theme set` matches "night" purely because one of
    #  its examples is "Tokyo Night". Real signal, useless answer.
    "commands": (8.0, 5.0, 1.0, 0.4, 1.0),
    #          sid  chapter heading body alt  source
    #  alt = de-hyphenated compounds; low weight, it is a fallback not a signal
    "sections": (0.0, 5.0, 8.0, 1.0, 2.0, 0.0),
}


def search(db, table, cols, expr, limit=5):
    if not expr:
        return []
    weights = ", ".join(str(w) for w in WEIGHTS[table])
    sql = (f"SELECT {', '.join(cols)}, bm25({table}, {weights}) AS score "
           f"FROM {table} WHERE {table} MATCH ? ORDER BY score LIMIT ?")
    try:
        rows = db.execute(sql, (expr, limit)).fetchall()
    except sqlite3.OperationalError:
        return []
    return [dict(zip(list(cols) + ["score"], r)) for r in rows]


# What the user is asking FOR separates the paths far better than how strongly
# BM25 scored. "how do I record my screen" and "command to update omarchy" both
# have strong exact hits; only the question's form says one wants an explanation
# and the other wants a command. Threshold sweeps top out at 13/20 without this.
ASK_LOOKUP = re.compile(
    r"\b(keybind\w*|hotkey|shortcut|binding|"
    r"(what|which)\s+(key|command|binary)|"
    r"command\s+(to|for|that)|key\s+(to|for)|bound\s+to)\b", re.I)

ASK_PROSE = re.compile(
    r"\b(how\s+(do|does|can|would|should)|what\s+(does|happens|is)\b|"
    # "what terminal does this use", "what browser is default" -- a question
    # about a thing, not a request for a key or a command. Without this the
    # score comparison sent it down the fast path and answered a question
    # about terminals with speaker-tuning commands.
    r"what\s+\w+\s+(does|do|is|are)\b|"
    r"why|explain|difference\s+between|set\s+up|configure|tell\s+me\s+about)\b", re.I)


def classify(query):
    """Return 'fast', 'prose', or None when the phrasing does not say."""
    lookup, prose = ASK_LOOKUP.search(query), ASK_PROSE.search(query)
    if lookup and not prose:
        return "fast"
    if prose and not lookup:
        return "prose"
    # Both or neither present: let the scores decide.
    return None


def retrieve(db, query, cfg):
    """Decide the path and gather evidence. Returns a dict describing the
    decision so the eval harness can check retrieval independently of the LLM."""
    binds = search(db, "binds", ("keys", "description"), match_expr(query, "binds"))
    cmds = search(db, "commands", ("route", "summary", "args", "examples"),
                  match_expr(query, "commands"))
    # Fetch a wide pool. The re-scoring below can only reorder what was
    # retrieved, so a tight limit silently defeats it: 06-themes#0 ranked just
    # outside a limit of 8, so its overview bonus never had anything to apply
    # to. SQLite makes the wider fetch free.
    secs = search(db, "sections", ("sid", "chapter", "heading", "body", "source"),
                  match_expr(query, "sections"), limit=40)

    # The packaged skill docs are written for coding agents, the manual for
    # people. Both are indexed because the skill docs cover config detail the
    # manual skips, but when they score close the manual is the better answer
    # to a "how do I" question, so it wins ties.
    for s in secs:
        if not s["source"].startswith("manual/"):
            s["score"] += SKILL_DOC_PENALTY

    secs.sort(key=lambda s: s["score"])
    secs = dedupe_by_chapter(secs)[:5]

    best_exact = min([r["score"] for r in binds + cmds], default=0.0)
    best_sec = min([r["score"] for r in secs], default=0.0)

    intent = classify(query)
    if intent == "fast":
        # Honour the ask only if the index actually has something to show.
        fast = best_exact <= cfg["fast_path_max_score"]
    elif intent == "prose":
        fast = False
    else:
        fast = (best_exact <= cfg["fast_path_max_score"]
                and best_exact <= best_sec - cfg["fast_path_margin"])

    return {
        "query": query, "path": "fast" if fast else "prose", "intent": intent,
        "binds": binds, "commands": cmds, "sections": secs,
        "best_exact": best_exact, "best_section": best_sec,
    }


def get_section(db, sid):
    row = db.execute(
        "SELECT sid, chapter, heading, body, source FROM sections WHERE sid = ?",
        (sid,)).fetchone()
    if not row:
        return None
    return dict(zip(("sid", "chapter", "heading", "body", "source"), row))


def chapter_sections(db, chapter_id):
    rows = db.execute(
        "SELECT sid, chapter, heading, body, source FROM sections "
        "WHERE sid LIKE ? ORDER BY sid", (f"{chapter_id}#%",)).fetchall()
    return [dict(zip(("sid", "chapter", "heading", "body", "source"), r)) for r in rows]


# --------------------------------------------------------------------------
# prompt
# --------------------------------------------------------------------------

def load_toc():
    """Return (outline_text, {number: sid}).

    Sections are numbered 1..N rather than printed as full ids. Two reasons:
    repeating "13-toggles-idle-screensaver#4" on every line more than doubled
    the outline (2,900 tokens vs 1,300), and a small model emitting a single
    integer is far more reliable than one reconstructing a compound id.
    """
    try:
        with open(TOC, encoding="utf-8") as fh:
            toc = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return "", {}

    lines, mapping, n = [], {}, 0
    for ch in toc:
        secs = ch["sections"]
        # 47 of 51 chapters' preamble sections are titled "overview", because
        # the chapter has no "##" headings. Printing the chapter name on one
        # line and "N overview" on the next leaves the model matching a query
        # against the word "overview" — it navigated "change the wallpaper" to
        # a theming section rather than to Backgrounds for exactly this reason.
        # A single-section chapter therefore becomes one self-describing line.
        if len(secs) == 1 and secs[0]["title"] == "overview":
            n += 1
            mapping[n] = secs[0]["id"]
            lines.append(f"{n} {ch['chapter']}")
            continue

        lines.append(f"{ch['chapter']}")
        for s in secs:
            n += 1
            mapping[n] = s["id"]
            title = ch["chapter"] if s["title"] == "overview" else s["title"]
            lines.append(f" {n} {title}")
    return "\n".join(lines), mapping


def render_toc():
    return load_toc()[0]


# Wording matters more than it looks: this prompt is also the prefix for the
# navigation call, and a friendlier "help with anything" system prompt cost two
# navigation hits on the prose set (27 -> 25 of 30). The permission to answer
# from general knowledge lives in the per-question turn instead (answer_prompt),
# which is what actually removed the refusals. Measured with tools/route-eval.py.
SYSTEM = """You are a local assistant for Omarchy, an Arch Linux distribution \
running Hyprland. You know Omarchy from the manual for THIS machine's \
installed version.

Rules:
- Take Omarchy facts only from text you are given. Never invent a keybinding, \
command, or config path.
- Be brief. Two or three sentences, or a short list. No preamble.
- Quote keybindings and commands exactly as written in the source.

Manual outline — chapter titles, with their numbered sections beneath:
{toc}"""


def build_system():
    return SYSTEM.format(toc=render_toc())


# Navigation may answer 0: nothing in the manual is relevant (a recipe, a patio,
# a Python question). That routes to general mode, where no manual text is
# injected and the model answers from its own knowledge. 0.2 had no such exit,
# so every off-topic question was forced onto some section and then refused
# with "the manual does not cover this".
GENERAL = {"sid": "", "chapter": "", "heading": "", "body": "", "source": "",
           "general": True}


def is_general(sec):
    return bool(sec and sec.get("general"))


# The model marks a request for something Omarchy cannot do with a last line
# "BUILD: <feature>". The panel turns it into a "Build it" card; it is stripped
# from the answer the user reads and from the stored transcript.
BUILD_HOW = ("If, and only if, the user wants their Omarchy computer to do "
             "something that neither Omarchy nor its installed apps can do, say "
             "plainly that it is not built in, then end your reply with one final "
             "line: BUILD: <what to build, in one short sentence>")

BUILD_RE = re.compile(r"^[ \t>*_`-]*BUILD:[*_` \t]*(.+?)[*_` \t]*$", re.M | re.I)


# A cheap first question, ~150ms on the GPU with a tiny prompt of its own:
# is this about the computer at all? Offering navigation a "0 = nothing
# relevant" exit on every question produced a false exit on "how do I change
# the wallpaper"; offering it only when this gate says OTHER keeps real
# questions on the 0.2 navigation path while recipes and patios leave it.
TOPIC_SYSTEM = (
    "You sort questions asked on an Omarchy Linux computer (Arch Linux, Hyprland "
    "desktop). Reply with exactly one word.\n"
    "COMPUTER: the question is about using, configuring or changing this computer, "
    "its desktop, apps, hardware, files, network or Linux, or asks the computer to "
    "do something.\n"
    "OTHER: anything else, such as cooking, home projects, general knowledge, or "
    "programming questions not about this machine.")


def on_topic(cfg, query):
    raw = chat(cfg, TOPIC_SYSTEM, f"Question: {query}\nOne word, COMPUTER or OTHER:",
               max_tokens=4, temperature=0.0)
    return "OTHER" not in raw.upper()


# Whether to offer "Build it" at all. The topic gate alone is not enough: it
# calls "a button in the bar that orders me a pizza" OTHER. Without the offer, a
# patio answer that says "Omarchy cannot build a patio" would become a build.
DESKTOPISH = re.compile(
    r"\b(omarchy|hyprland|linux|desktop|computer|laptop|pc|machine|bar|panel|"
    r"widget|plugin|app|apps|application|menu|window|screen|keyboard|"
    r"terminal|notification|wallpaper|theme)s?\b", re.I)


def route(db, cfg, system, query, res):
    """Pick the evidence for an answer. Returns (section or GENERAL, offer_build)."""
    computer = on_topic(cfg, query)
    offer = computer or bool(DESKTOPISH.search(query))
    if not computer and not res["sections"]:
        return GENERAL, offer          # nothing to navigate to; skip the call
    sec, _ = navigate(db, cfg, system, query, res["sections"], allow_general=not computer)
    if sec is None:
        sec = res["sections"][0] if res["sections"] else GENERAL
    return sec, offer


# A 4B model often says "Omarchy doesn't have a built-in X" and then forgets
# the BUILD line. When it says so in words, one short dedicated call names the
# feature instead.
NOT_BUILT = re.compile(
    r"(doesn.t|does not|don.t|do not|isn.t|is not|can.t|cannot|no)\s+"
    r"(have\s+(a|any)\s+)?(built[- ]in|native(ly)?|support|include|come with|"
    r"a feature|such a feature|ship)", re.I)

BUILD_SYSTEM = ("You name software features. Reply with one short sentence that "
                "describes the feature to build, starting with a verb, or the "
                "single word NONE.")


def detect_build(cfg, query, text, offer):
    """Return (answer without BUILD lines, feature or None)."""
    cleaned, feature = split_build(text)
    if not offer:
        return cleaned, None
    if feature or not NOT_BUILT.search(cleaned):
        return cleaned, feature
    try:
        raw = chat(cfg, BUILD_SYSTEM,
                   f"The user asked their Omarchy computer: {query}\n"
                   f"The assistant answered: {cleaned[:1200]}\n\n"
                   "If the answer says Omarchy cannot already do what the user wants, "
                   "describe the missing feature in one sentence. Otherwise reply NONE.",
                   max_tokens=48, temperature=0.0)
    except ServerDown:
        return cleaned, None
    line = raw.strip().splitlines()[0].strip().strip("`*\"") if raw.strip() else ""
    if not line or line.upper().startswith("NONE"):
        return cleaned, None
    return cleaned, line.rstrip(".")


def split_build(text):
    """Return (answer without BUILD lines, feature or None)."""
    m = BUILD_RE.search(text or "")
    if not m:
        return text, None
    feature = m.group(1).strip().rstrip(".")
    cleaned = BUILD_RE.sub("", text).rstrip()
    return cleaned, (feature or None)


def answer_tokens(cfg, general, chat=False):
    """Manual answers are two or three sentences; a recipe or a how-to from
    general knowledge is a numbered list and was being cut off at 400."""
    base = cfg["max_tokens"] * (2 if chat else 1)
    return max(base, cfg["general_max_tokens"]) if general else base


def answer_prompt(query, sec, cfg, cards=None, chat=False, offer_build=True):
    """The user turn for one answer. Omarchy mode injects the section; general
    mode injects nothing and says so, which is what stops the refusal."""
    ctx = ""
    if sec and not is_general(sec):
        ctx += (f"MANUAL SECTION {sec['sid']} ({sec['chapter']} - {sec['heading']}):\n"
                f"{sec['body'][:cfg['max_inject_chars']]}\n\n")
    if cards:
        ctx += "MATCHING CARDS FROM THE INDEX:\n" + "\n".join(cards) + "\n\n"
    convo = " and the conversation so far" if chat else ""
    if ctx:
        how = (f"Use the material above{convo} for anything Omarchy-specific. Where "
               "it is silent, answer from your own knowledge, but never invent an "
               "Omarchy keybinding, command or config path.")
    else:
        how = (f"The Omarchy manual does not cover this. Answer helpfully from your "
               f"own knowledge{convo}. Do not mention the manual.")
    return f"{ctx}QUESTION: {query}\n\n{how}" + (f"\n{BUILD_HOW}" if offer_build else "")


# --------------------------------------------------------------------------
# model
# --------------------------------------------------------------------------

class ServerDown(Exception):
    pass


def chat(cfg, system, user, max_tokens=None, temperature=None):
    payload = json.dumps({
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": user}],
        "temperature": cfg["temperature"] if temperature is None else temperature,
        "max_tokens": max_tokens or cfg["max_tokens"],
        "cache_prompt": True,
        # Qwen3.x reasoning traces would blow the latency budget on every lookup.
        "chat_template_kwargs": {"enable_thinking": False},
    }).encode()

    req = urllib.request.Request(
        f"{cfg['server']}/v1/chat/completions",
        data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=cfg["timeout"]) as r:
            data = json.load(r)
    except urllib.error.URLError as e:
        raise ServerDown(str(e)) from e
    except TimeoutError as e:
        raise ServerDown(f"timed out after {cfg['timeout']}s") from e

    try:
        text = data["choices"][0]["message"]["content"].strip()
    except (KeyError, IndexError) as e:
        raise ServerDown(f"unexpected response shape: {e}") from e
    # Strip a stray reasoning block if the template emitted one anyway.
    return re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL).strip()


def chat_stream(cfg, messages, max_tokens=None, temperature=None):
    """Yield content deltas from a streaming completion (SSE over HTTP)."""
    payload = json.dumps({
        "messages": messages,
        "temperature": cfg["temperature"] if temperature is None else temperature,
        "max_tokens": max_tokens or cfg["max_tokens"],
        "cache_prompt": True,
        "stream": True,
        "chat_template_kwargs": {"enable_thinking": False},
    }).encode()
    req = urllib.request.Request(
        f"{cfg['server']}/v1/chat/completions",
        data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=cfg["timeout"]) as r:
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    delta = json.loads(data)["choices"][0].get("delta", {}).get("content")
                except (ValueError, KeyError, IndexError):
                    continue
                if delta:
                    yield delta
    except urllib.error.URLError as e:
        raise ServerDown(str(e)) from e
    except TimeoutError as e:
        raise ServerDown(f"timed out after {cfg['timeout']}s") from e


SECTION_RE = re.compile(r"[0-9a-z][0-9a-z-]*#\d+")
CHAPTER_RE = re.compile(r"\b(\d{2}-[a-z0-9-]+|skill-[a-z0-9-]+)\b")


def navigate(db, cfg, system, query, candidates, allow_general=False):
    """PageIndex call 1: model picks a section id from the cached outline.

    BM25's top hits are offered as a hint, but the model may pick anything in
    the outline -- that is the point of navigation over pure lexical search.
    """
    _, numbers = load_toc()
    by_sid = {sid: n for n, sid in numbers.items()}

    hint = ""
    if candidates:
        rows = []
        for s in candidates[:5]:
            n = by_sid.get(s["sid"])
            if n:
                rows.append(f"  {n} {s['chapter']} - {s['heading']}")
        if rows:
            hint = "\n\nLexical search suggests these, but choose freely:\n" + "\n".join(rows)

    user = (f"QUESTION: {query}{hint}\n\n"
            "Reply with ONE section number from the outline and nothing else."
            + (" If no part of the Omarchy manual is relevant to the question, reply 0."
               if allow_general else ""))
    # Navigation is a lookup, not a creative act: greedy decoding only. The
    # token budget is generous enough that a model which emits a reasoning
    # block anyway still gets to the number (see prose_smoke in bench.sh).
    raw = chat(cfg, system, user, max_tokens=64, temperature=0.0)

    # Preferred form: a bare section number.
    m = re.search(r"\b(\d{1,4})\b", raw)
    # 0 must be honoured before the fallbacks below: they would otherwise
    # drag an off-topic question back onto whatever chapter BM25 liked.
    if allow_general and m and int(m.group(1)) == 0:
        return GENERAL, raw
    if m:
        sec = get_section(db, numbers.get(int(m.group(1)), ""))
        if sec:
            return sec, raw

    # Older prompts asked for a full section id; still accept one.
    m = SECTION_RE.search(raw)
    if m:
        sec = get_section(db, m.group(0))
        if sec:
            return sec, raw
    # Model named a chapter rather than a section; take that chapter's best
    # section according to BM25, or its first.
    m = CHAPTER_RE.search(raw)
    if m:
        secs = chapter_sections(db, m.group(1))
        if secs:
            ranked = [s for s in candidates if s["sid"].startswith(m.group(1) + "#")]
            return (ranked[0] if ranked else secs[0]), raw
    return None, raw


# --------------------------------------------------------------------------
# rendering
# --------------------------------------------------------------------------

def wrap(text, width=76, indent=""):
    out = []
    for para in text.split("\n"):
        if not para.strip():
            out.append("")
            continue
        out.extend(textwrap.wrap(para, width=width, initial_indent=indent,
                                 subsequent_indent=indent) or [""])
    return "\n".join(out)


def render_fast(res, cfg):
    """Show the best binds and the best commands, judged against their own
    table's top score. A shared cutoff hid the keybinding whenever a command
    happened to score higher -- but "the key AND the command that does the same
    thing" is exactly the useful answer."""
    lines = []

    strong = [b for b in res["binds"]
              if b["score"] <= cfg["fast_path_max_score"]]
    if strong:
        best = strong[0]["score"]
        for b in strong[:3]:
            if b["score"] > best + 1.5:
                break
            lines.append(f"  {c(b['keys'], '1;36'):<40} {b['description']}")

    strong = [cm for cm in res["commands"]
              if cm["score"] <= cfg["fast_path_max_score"]]
    if strong:
        if lines:
            lines.append("")
        best = strong[0]["score"]
        for cm in strong[:3]:
            if cm["score"] > best + 1.5:
                break
            route = f"{cm['route']} {cm['args']}".strip()
            lines.append(f"  {c(route, '1;32')}")
            if cm["summary"]:
                lines.append(f"      {cm['summary']}")
    return "\n".join(lines)


def render_sources(items):
    return c("  " + "  ".join(items), "2")


# --------------------------------------------------------------------------
# answering
# --------------------------------------------------------------------------

def answer(db, cfg, query, system, verbose=False):
    t0 = time.time()
    res = retrieve(db, query, cfg)

    if res["path"] == "fast":
        body = render_fast(res, cfg)
        if body:
            print()
            print(body)
            print()
            print(render_sources([f"{time.time() - t0:.2f}s", "index (no model)"]))
            return res

    # Prose path.
    try:
        sec, offer = route(db, cfg, system, query, res)
    except ServerDown as e:
        print()
        print(c("  llama-server is not reachable.", "1;33"))
        print(f"  {e}")
        if res["sections"]:
            s = res["sections"][0]
            print()
            print(c(f"  Closest manual section ({s['source']} - {s['heading']}):", "2"))
            print()
            print(wrap(s["body"][:1200], indent="  "))
        print()
        return res

    general = is_general(sec)
    res["chosen_section"] = "" if general else sec["sid"]
    res["mode"] = "general" if general else "omarchy"
    user = answer_prompt(query, sec, cfg, offer_build=offer)
    try:
        reply = chat(cfg, system, user, max_tokens=answer_tokens(cfg, general))
    except ServerDown as e:
        print(f"\n  {c('llama-server went away:', '1;33')} {e}\n")
        return res

    reply, feature = detect_build(cfg, query, reply, offer)
    res["build"] = feature
    print()
    print(wrap(reply, indent="  "))
    if feature:
        print()
        print(c(f"  Not built in. The help panel can start building: {feature}", "1;36"))
    print()
    print(render_sources([f"{time.time() - t0:.2f}s"]
                         + (["general knowledge (model)"] if general
                            else [sec["source"], f"§{sec['heading']}"])))
    if verbose:
        print(c(f"  [nav -> {sec['sid'] or 'general'}]", "2"))
    return res


# --------------------------------------------------------------------------
# entry
# --------------------------------------------------------------------------

def repl(db, cfg, system):
    print(c("  Omarchy local agent", "1") + c("   (ctrl-d to exit)", "2"))
    meta = dict(db.execute("SELECT key, value FROM meta").fetchall())
    print(c(f"  manual {meta.get('manual_ref', '?')} | "
            f"{meta.get('n_binds', '?')} binds | "
            f"{meta.get('n_commands', '?')} commands", "2"))
    while True:
        try:
            q = input(c("\n> ", "1;36")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not q:
            continue
        if q in ("exit", "quit"):
            return
        try:
            answer(db, cfg, q, system)
        except KeyboardInterrupt:
            print(c("\n  interrupted", "2"))


APP_ID = "omarchy-local-agent"

# Each terminal spells "set the window app-id" differently, and the app-id is
# what the Hyprland float rule matches on.
TERMINAL_APP_ID_FLAG = {
    "foot": "--app-id={}",
    "alacritty": "--class={}",
    "kitty": "--class={}",
    "ghostty": "--class={}",
}


def popup():
    """Relaunch ourselves in a floating terminal window."""
    import shutil
    import subprocess

    # Respect the user's configured Omarchy terminal where we know how to pass
    # an app-id to it; otherwise take whatever is installed.
    preferred = os.environ.get("TERMINAL", "")
    order = [preferred] if preferred in TERMINAL_APP_ID_FLAG else []
    order += ["ghostty", "alacritty", "kitty", "foot"]

    for term in order:
        path = shutil.which(term)
        if not path:
            continue
        cmd = [path, TERMINAL_APP_ID_FLAG[term].format(APP_ID),
               "-e", os.path.abspath(__file__), "--repl"]
        try:
            subprocess.Popen(cmd, start_new_session=True)
            return 0
        except OSError as e:
            print(f"could not launch {term}: {e}", file=sys.stderr)
    print("no supported terminal found", file=sys.stderr)
    return 1


# How far below the best hit a live-search result may score and still be shown.
LIVE_MARGIN = 2.0


def near_best(rows, margin=LIVE_MARGIN):
    """Keep rows scoring within `margin` of the best one."""
    if not rows:
        return rows
    best = rows[0]["score"]
    return [r for r in rows if r["score"] <= best + margin]


def search_daemon():
    """One query per line on stdin, one JSON result per line on stdout.

    The GUI searches on every keystroke. Spawning this script per keystroke
    costs ~100ms, nearly all of it interpreter and import startup, which reads
    as lag while typing. Holding the process open makes each query ~1ms.
    """
    cfg = load_config()
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    for line in sys.stdin:
        query = line.strip()
        if not query:
            continue
        try:
            # Live search differs from answering in two ways: prefix-match the
            # word being typed, and show whatever matched rather than applying
            # the answer-mode score cutoff. The user is browsing a list and
            # picking, so an imperfect match is still useful; silence is not.
            binds = search(db, "binds", ("keys", "description"),
                           match_expr(query, "binds", prefix=True))
            cmds = search(db, "commands", ("route", "summary", "args", "examples"),
                          match_expr(query, "commands", prefix=True))
            secs = search(db, "sections",
                          ("sid", "chapter", "heading", "body", "source"),
                          match_expr(query, "sections", prefix=True), limit=40)
            for s in secs:
                if not s["source"].startswith("manual/"):
                    s["score"] += SKILL_DOC_PENALTY
            secs.sort(key=lambda s: s["score"])
            secs = dedupe_by_chapter(secs)[:5]

            # Show only what is competitive with the best hit in each table.
            # A fixed cutoff is wrong here (scores scale with query length), but
            # a trailing tail of weak matches is exactly what makes a live list
            # feel noisy rather than helpful.
            binds = near_best(binds)
            cmds = near_best(cmds)

            out = {
                "query": query,
                "binds": [{"keys": b["keys"], "description": b["description"]}
                          for b in binds[:5]],
                "commands": [{"route": c["route"], "args": c["args"],
                              "summary": c["summary"]} for c in cmds[:5]],
                "sections": [{"sid": s["sid"], "chapter": s["chapter"],
                              "heading": s["heading"], "source": s["source"]}
                             for s in secs],
            }
        except Exception as e:  # one bad query must never kill the daemon
            out = {"query": query, "error": str(e),
                   "binds": [], "commands": [], "sections": []}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.stdout.flush()


def explain_section(sid, query):
    """Answer using one specific manual section — the GUI already knows which
    section the user highlighted, so navigation (model call 1) is skipped
    entirely. Prints plain text on stdout."""
    cfg = load_config()
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    sec = get_section(db, sid)
    if sec is None:
        print(f"No such section: {sid}")
        return 1
    user = answer_prompt(query, sec, cfg)
    try:
        print(split_build(chat(cfg, build_system(), user))[0])
    except ServerDown as e:
        print(f"The local model is not running.\n\n{e}\n\n"
              f"Start it with:  systemctl --user start omarchy-local-agent\n\n"
              f"From the manual ({sec['source']} - {sec['heading']}):\n\n"
              f"{sec['body'][:1500]}")
        return 1
    return 0


CHAT_SUFFIX = """

You are now in a back-and-forth conversation. Use the conversation so far for \
context. When a command or keybinding solves the problem, put it on its own line."""

NOT_RUNNING = ("The local model is not running.\n\n"
               "Start it with:  systemctl --user start omarchy-local-agent")


def chat_context(db, cfg, system, query, sid):
    """Pick the evidence for one chat turn: a manual section (kept from the
    previous turn when the GUI passes its sid, navigated otherwise) plus the
    best keybinding/command cards from the index."""
    res = retrieve(db, query, cfg)
    sec = get_section(db, sid) if sid else None
    if sec is None:
        sec, offer = route(db, cfg, system, query, res)
    else:
        offer = True
    if is_general(sec):
        # near_best() is relative to the best hit, so an off-topic question
        # would still carry three unrelated cards into the prompt.
        return sec, [], offer
    cards = [f"keybinding {b['keys']}: {b['description']}"
             for b in near_best(res["binds"])[:3]]
    cards += [f"command {cm['route']}: {cm['summary']}"
              for cm in near_best(res["commands"])[:3]]
    return sec, cards, offer


def chat_daemon():
    """Conversation mode for the GUI. One JSON request per stdin line:
        {"id": N, "query": "...", "history": [{"role","content"}...], "sid": "..."}
    Replies are JSON lines keyed by the same id: {"status"} once evidence is
    chosen, {"delta"} while the model streams, then {"done": true, "sid",
    "heading", "source", "seconds"} or {"error", "hint", "fallback"}."""
    cfg = load_config()
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    system = None

    def emit(obj):
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except ValueError:
            emit({"error": "malformed request"})
            continue
        rid = req.get("id", 0)
        query = str(req.get("query") or "").strip()
        history = req.get("history") or []
        sid = str(req.get("sid") or "")
        if not query:
            emit({"id": rid, "error": "empty question"})
            continue
        t0 = time.time()
        sec = None
        try:
            if system is None:
                system = build_system() + CHAT_SUFFIX
            sec, cards, offer = chat_context(db, cfg, system, query, sid)
            general = is_general(sec)
            emit({"id": rid, "status": "generating",
                  "mode": "general" if general else "omarchy",
                  "sid": sec["sid"], "heading": sec["heading"],
                  "source": sec["source"]})
            user = answer_prompt(query, sec, cfg, cards, chat=True, offer_build=offer)
            messages = [{"role": "system", "content": system}]
            for h in history[-8:]:
                if h.get("role") in ("user", "assistant") and h.get("content"):
                    messages.append({"role": h["role"],
                                     "content": str(h["content"])[:4000]})
            messages.append({"role": "user", "content": user})

            hidden = False
            answer_text = ""
            for delta in chat_stream(cfg, messages,
                                     max_tokens=answer_tokens(cfg, general, chat=True)):
                # Drop a reasoning block if the template emitted one anyway.
                if "<think>" in delta:
                    hidden = True
                if hidden:
                    if "</think>" in delta:
                        hidden = False
                    continue
                answer_text += delta
                emit({"id": rid, "delta": delta})
            answer_text, feature = detect_build(cfg, query, answer_text, offer)
            transcript = messages[1:-1] + [{"role": "user", "content": query},
                                           {"role": "assistant", "content": answer_text}]
            done = {"id": rid, "done": True, "text": answer_text,
                    "mode": "general" if general else "omarchy",
                    "steps": analyse_steps(cfg, system, transcript, answer_text, db),
                    "sid": sec["sid"], "heading": sec["heading"],
                    "source": sec["source"],
                    "seconds": round(time.time() - t0, 1)}
            if feature:
                done["build"] = {"feature": feature}
            emit(done)
        except ServerDown as e:
            out = {"id": rid, "error": f"{NOT_RUNNING}\n\n{e}",
                   "hint": "systemctl --user start omarchy-local-agent"}
            if sec and not is_general(sec):
                out.update({"sid": sec["sid"], "heading": sec["heading"],
                            "source": sec["source"],
                            "fallback": sec["body"][:1500]})
            emit(out)
        except Exception as e:  # one bad turn must never kill the daemon
            emit({"id": rid, "error": str(e)})


# --------------------------------------------------------------------------
# opening things: a manual section in a pager, a command in a terminal
# --------------------------------------------------------------------------

MAX_SECTION = 4000  # must match omarchy-local-agent-index


def _line_at(text, offset):
    return text.count("\n", 0, offset) + 1


def _first_ink(text, offset, body):
    """Offset of the first non-blank character of a body that starts at offset."""
    return offset + (len(body) - len(body.lstrip()))


def section_lines(text, strip_h1):
    """Mirror of the indexer's split_sections that records, for every section
    it would produce, the heading text and the 1-based line to open at. The
    two must stay in step, so the index row is checked against the result."""
    if strip_h1:
        # The indexer drops the H1; replacing it with "" keeps line numbers.
        text = re.sub(r"^#\s+.+$", "", text, count=1, flags=re.MULTILINE)

    def split_on(seg, base, pattern):
        """(heading, body, body_base, open_at): body_base is the absolute
        offset of body inside text, open_at the offset of the line to open."""
        out = []
        ms = list(re.finditer(pattern, seg, flags=re.MULTILINE))
        pre = seg[:ms[0].start()] if ms else seg
        if pre.strip():
            out.append((None, pre, base, _first_ink(seg, base, pre)))
        for i, m in enumerate(ms):
            end = ms[i + 1].start() if i + 1 < len(ms) else len(seg)
            body = seg[m.end():end]
            if body.strip():
                out.append((m.group(1).strip(), body, base + m.end(), base + m.start()))
        return out

    def paragraphs(heading, body, line):
        chunks, cur = [], ""
        for para in body.split("\n\n"):
            if cur and len(cur) + len(para) + 2 > MAX_SECTION:
                chunks.append(cur.strip())
                cur = para
            else:
                cur = f"{cur}\n\n{para}" if cur else para
        if cur.strip():
            chunks.append(cur.strip())
        if len(chunks) == 1:
            return [(heading, line)]
        out, pos = [], 0
        for i, ch in enumerate(chunks):
            at = text.find(ch[:80], pos)
            pos = at + 1 if at >= 0 else pos
            title = f"{heading} ({i + 1}/{len(chunks)})" if heading else None
            out.append((title, _line_at(text, at) if at >= 0 else line))
        return out

    out = []
    for heading, body, body_base, open_at in split_on(text, 0, r"^##\s+(.+)$"):
        line = _line_at(text, open_at)
        stripped = body.strip()
        if len(stripped) <= MAX_SECTION:
            out.append((heading, line))
            continue
        sub = split_on(body, body_base, r"^###\s+(.+)$")
        if len(sub) > 1:
            for sh, sb, _, sopen in sub:
                sline = _line_at(text, sopen)
                title = sh or heading
                if len(sb.strip()) > MAX_SECTION:
                    out.extend(paragraphs(title, sb.strip(), sline))
                else:
                    out.append((title, sline))
        else:
            out.extend(paragraphs(heading, stripped, line))
    return out


def section_location(db, sid):
    """Return (path, line, section) for a section id, or None."""
    sec = get_section(db, sid)
    if sec is None:
        return None
    src = sec["source"]
    path = os.path.join(ROOT, src) if src.startswith("manual/") else src
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    line = 1
    try:
        idx = int(sid.rsplit("#", 1)[1])
        rows = section_lines(text, strip_h1=src.startswith("manual/"))
        heading, cand = rows[idx]
        if (heading or sec["chapter"]) == sec["heading"]:
            line = cand
        else:
            raise ValueError("index and split disagree")
    except (ValueError, IndexError):
        # Fall back to the heading text; the first occurrence is the best guess.
        want = re.sub(r" \(\d+/\d+\)$", "", sec["heading"])
        for n, l in enumerate(text.splitlines(), 1):
            if re.match(r"^#{2,3}\s+" + re.escape(want) + r"\s*$", l):
                line = n
                break
    return path, line, sec


def spawn(argv):
    import subprocess
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_section(sid, print_only=False):
    """Open the manual file at the section's heading in a floating terminal."""
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    loc = section_location(db, sid)
    if loc is None:
        print(f"No such section: {sid}", file=sys.stderr)
        return 1
    path, line, sec = loc
    argv = ["omarchy-launch-tui", "--app-id=TUI.float",
            "nvim", "-R", f"+{line}", "-c", "normal! zt", path]
    if print_only:
        print(json.dumps({"sid": sid, "heading": sec["heading"], "path": path,
                          "line": line, "argv": argv}))
        return 0
    spawn(argv)
    return 0


# A command with no <placeholder> runs at once; one with placeholders is put
# on an editable prompt so they can be filled in before Enter.
# --------------------------------------------------------------------------
# execution policy
# --------------------------------------------------------------------------
# The user chose this model for anything the panel executes: an allowlist
# (commands the index knows) plus a human confirmation per step, never a plain
# denylist. Refused patterns are never run, never proposed, never put on the
# prompt. Writes only under $HOME.

REFUSE = [
    (r"(^|[\s;&|(`$])(sudo|pkexec|doas|su)(\s|$)", "privilege escalation is never run from the help panel"),
    (r"(^|[\s;&|(`$/])rm(\s+-[A-Za-z]+|\s+--[a-z-]+)*\s+(-[A-Za-z]*[rR][A-Za-z]*|--recursive)(\s|$)",
     "recursive rm is never run from the help panel"),
    (r"-exec(dir)?\s+(/[\w/]*/)?(rm|shred|dd|mkfs|chmod|chown)(\s|$)",
     "find -exec with a destructive command is never run from the help panel"),
    (r"(^|[\s;&|(`$])xargs\b[^;&|]*?(^|\s)(/[\w/]*/)?(rm|shred|chmod|chown|dd|mkfs)(\s|$)",
     "xargs into a destructive command is never run from the help panel"),
    (r"(?i)(^|[\s;&|(`$/])(sudo\s+)?(sh|bash|zsh|fish|dash|ksh|python3?|perl|ruby|node)\s+(-[A-Za-z]*[ce]|--command|--eval)(\s|$)",
     "handing a step to an interpreter is never done from the help panel"),
    (r"(^|[;&|(`$]\s*|\bsudo\s+)(/[\w/]*/)?(eval|watch|exec)(\s|$)",
     "eval, watch and exec are never run from the help panel"),
    (r"(^|[\s;&|(`$])dd(\s|$)", "dd is never run from the help panel"),
    (r"(^|[\s;&|(`$])mkfs(\.|\s|$)", "mkfs is never run from the help panel"),
    (r"(^|[\s;&|(`$])(reboot|shutdown|poweroff|halt)(\s|$)", "power commands are never run from the help panel"),
    (r"(^|[\s;&|(`$])systemctl\s+(?!--user)", "system-level systemctl needs root; not run from the help panel"),
    (r"(>>?|\b(tee|cp|mv|install|ln|chmod|chown|mkdir|touch|rmdir|sed\s+-i[^ ]*))\s*[^;&|]*?\s?/(usr|etc|boot|dev)(/|\s|$)",
     "writes outside $HOME are never run from the help panel"),
    (r"(?i)\|\s*(sudo\s+)?(/[\w/]*/)?(sh|bash|zsh|fish|dash|ksh|python3?|perl|ruby|node)(\s|$)",
     "piping into a shell or interpreter is never run from the help panel"),
    (r"(^|[\s;&|(`$])find(\s|$)[^;&|]*\s-delete(\s|$)", "find -delete is unrecoverable deletion; never run from the help panel"),
    (r"(^|[\s;&|(`$])shred(\s|$)", "shred is unrecoverable deletion; never run from the help panel"),
    (r":\s*\(\s*\)\s*\{", "fork bomb; never run from the help panel"),
    (r"/etc/g?shadow(\s|$)", "credential files are never read from the help panel"),
]

HOME_MARKS = ("~", "$HOME", "${HOME}")


def _expand(path):
    for m in HOME_MARKS:
        if path == m or path.startswith(m + "/"):
            return HOME + path[len(m):]
    return path


def under_home(path):
    """True for a path strictly inside $HOME (the home root itself is not)."""
    p = os.path.normpath(_expand(path))
    return p.startswith(HOME + "/")


def recursive_perm_target(cmd):
    """The user's rule: a recursive chmod/chown/chgrp is a machine-wrecker
    unless every target is inside $HOME. Returns a reason or None."""
    for m in re.finditer(r"(^|[\s;&|(`$])(chmod|chown|chgrp)\s+([^;&|]*)", cmd):
        args = m.group(3).split()
        flags = [a for a in args if a.startswith("-")]
        if not any(a == "--recursive" or (a.startswith("-") and not a.startswith("--") and "R" in a)
                   for a in flags):
            continue
        rest = [a for a in args if not a.startswith("-")]
        targets = rest[1:]                       # first non-flag is the mode/owner
        if not targets or any(not under_home(t) for t in targets):
            return f"recursive {m.group(2)} outside $HOME is never run from the help panel"
    return None


WRITE_VERBS = {"cp", "mv", "install", "tee", "mkdir", "touch", "rm", "rmdir", "chmod", "chown",
               "chgrp", "ln", "truncate", "dd"}


def looks_like_path(tok):
    t = tok.strip("'\"")
    return (t.startswith(("/", "~", "$HOME", "./", "../")) or "/" in t) and not t.startswith("-") \
        and not t.startswith(("http://", "https://"))


def touches(cmd):
    """Heuristic preview of what a command reads and writes, for the step
    button. Shell redirections and the usual write verbs count as writes;
    every other path-like token is listed as a read."""
    import shlex
    try:
        toks = shlex.split(cmd)
    except ValueError:
        toks = cmd.split()
    reads, writes = [], []
    verb, expect_write = None, False
    for i, t in enumerate(toks):
        if t in (";", "&&", "||", "|", "&"):
            verb, expect_write = None, False
            continue
        if t in (">", ">>", "-o", "--output"):
            expect_write = True
            continue
        if t.startswith((">", ">>")) and len(t) > 1 and looks_like_path(t.lstrip(">")):
            writes.append(_expand(t.lstrip(">")))
            continue
        if verb is None and not t.startswith("-"):
            verb = t
            continue
        if not looks_like_path(t):
            continue
        p = _expand(t.strip("'\""))
        if expect_write:
            writes.append(p); expect_write = False
        elif verb in WRITE_VERBS:
            # cp/mv/install write their last operand, the rest are reads
            later = [x for x in toks[i + 1:] if looks_like_path(x)]
            (writes if (verb not in ("cp", "mv", "install") or not later) else reads).append(p)
        else:
            reads.append(p)
    dedupe = lambda xs: list(dict.fromkeys(xs))
    return dedupe(reads), dedupe(writes)


# An inline span counts only when it starts with the command: a path such as
# ~/.config/omarchy/backgrounds also contains the word, and is not a step.
STEP_INLINE = re.compile(r"`(?:\$ ?)?(omarchy(?:-[a-z-]+)?(?:\s[^`]*)?)`")


def extract_steps(text):
    """Commands an answer proposes: fenced code lines, `$ …` lines, lines
    starting with omarchy, and inline `omarchy …` spans. Mirrors what the
    panel shows as one Run button per step."""
    out, seen, fence = [], set(), False

    def add(c):
        c = re.sub(r"^\$\s*", "", c).strip()
        if c and c not in seen and len(c) <= 200:
            seen.add(c); out.append(c)

    for raw in (text or "").splitlines():
        l = raw.strip()
        if l.startswith("```"):
            fence = not fence; continue
        if fence:
            if l and not l.startswith("#"):
                add(l)
            continue
        spans = STEP_INLINE.findall(l)
        if spans:
            for c in spans:
                add(c)
            continue
        if re.match(r"^\$\s+\S", l) or re.match(r"^omarchy(-[a-z-]+)?\s", l):
            add(l)
    return out[:8]


FILL_SYSTEM = ("You fill in command-line templates for an Omarchy Linux user. Use only "
               "values stated in the conversation. Reply with the finished command on "
               "one line and nothing else, or the single word UNKNOWN.")


def fill_placeholders(cfg, system, transcript, cmd):
    """The user chose "ask the model to fill in arguments": one greedy call
    that must return the finished command or UNKNOWN. The result is shown
    on the button before anything runs, and policy is applied to it."""
    convo = "\n".join(f"{m['role']}: {m['content']}" for m in transcript[-8:])
    user = (f"Conversation so far:\n{convo}\n\n"
            f"Command template: {cmd}\n\n"
            "Replace every <placeholder> with the concrete value the conversation "
            "implies. Reply with the finished command on one line and nothing else. "
            "If a value is not stated in the conversation, reply UNKNOWN.")
    # The main system prompt tells the model to answer only from the manual,
    # which makes it say UNKNOWN here even when the conversation names the
    # value; a short dedicated prompt fills correctly and still refuses when
    # nothing is stated.
    try:
        raw = chat(cfg, FILL_SYSTEM, user, max_tokens=80, temperature=0.0)
    except ServerDown:
        return None
    line = raw.strip().splitlines()[0].strip().strip("`") if raw.strip() else ""
    head = cmd.split()[0]
    if not line or "UNKNOWN" in line.upper() or "<" in line or not line.startswith(head):
        return None
    return line


def analyse_steps(cfg, system, transcript, text, db=None):
    steps = []
    for cmd in extract_steps(text):
        resolved = None
        if "<" in cmd and len(steps) < 4:
            resolved = fill_placeholders(cfg, system, transcript, cmd)
        final = resolved or cmd
        v = command_policy(final, db)
        reads, writes = touches(final)
        steps.append({"cmd": cmd, "resolved": resolved or "", "verdict": v["verdict"],
                      "reason": v["reason"], "reads": reads, "writes": writes})
    return steps


def command_policy(cmd, db=None):
    """Return {"verdict": "run" | "prompt" | "refuse", "reason": str}.

    run     allowlisted (an `omarchy` route the index knows) and complete
    prompt  anything else that is not refused: shown on an editable prompt
    refuse  matches a hard-refuse pattern; never executed
    """
    c = " ".join(cmd.strip().split())
    if not c:
        return {"verdict": "refuse", "reason": "empty command"}
    # Matchers run on a normalised copy: backslashes removed, single-word
    # quoting undone ('rm', "rm", \rm are rm to the shell), and any longer
    # quoted string replaced by a placeholder so prose inside quotes (a commit
    # message that mentions rm -rf) is opaque. Interpreter payloads need no
    # inspection: sh -c / python -c are refused whatever they carry.
    bare = c.replace("\\", "")
    bare = re.sub(r"(['\"])([\w./~-]+)\1", r"\2", bare)
    bare = re.sub(r"'[^']*'|\"[^\"]*\"", "QUOTED", bare)
    for pat, why in REFUSE:
        if re.search(pat, bare):
            return {"verdict": "refuse", "reason": why}
    why = recursive_perm_target(bare)
    if why:
        return {"verdict": "refuse", "reason": why}
    if "<" in c:
        return {"verdict": "prompt", "reason": "has a placeholder to fill in"}
    # An allowlisted command is a plain argv, nothing the shell could expand:
    # no ; & | $ ` ( ) < > \ or newline anywhere, quotes limited to simple words.
    if not re.fullmatch(r"[\w\s./~@:=+,%'\"-]+", c):
        return {"verdict": "prompt", "reason": "shell syntax in the command; confirm it on the prompt"}
    known = False
    try:
        own = db or sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
        for (route,) in own.execute("SELECT route FROM commands"):
            r = " ".join(str(route).split())
            if c == r or c.startswith(r + " "):
                known = True
                break
    except sqlite3.Error:
        known = False
    if known:
        return {"verdict": "run", "reason": "omarchy command from the index"}
    return {"verdict": "prompt", "reason": "not an indexed omarchy command; confirm it on the prompt"}


def notify(title, body):
    try:
        spawn(["omarchy-notification-send", "-u", "critical", title, body])
    except OSError:
        print(f"{title}: {body}", file=sys.stderr)


RUN_SCRIPT = ('if [[ $OH_MODE == run ]]; then line=$OH_CMD; printf "$ %s\\n" "$line"; '
              'else read -e -i "$OH_CMD" -p "$ " line; fi; '
              'eval "$line"; echo; read -rp "Press Enter to close "')


def run_command(cmd, print_only=False):
    """Open a floating terminal for one command, under command_policy():
    an indexed omarchy command runs at once (the click was the confirmation),
    anything else is shown on an editable prompt first, refused patterns
    never run. The command travels in the environment, never through a shell
    string."""
    verdict = command_policy(cmd)
    if verdict["verdict"] == "refuse":
        if print_only:
            print(json.dumps({"cmd": cmd, "argv": None, "policy": verdict}))
            return 2
        notify("Omarchy Help refused to run that", f"{cmd}\n{verdict['reason']}")
        print(f"refused: {verdict['reason']}", file=sys.stderr)
        return 2
    argv = ["omarchy-launch-tui", "--app-id=TUI.float",
            "env", f"OH_CMD={cmd}", f"OH_MODE={verdict['verdict']}", "bash", "-c", RUN_SCRIPT]
    if print_only:
        print(json.dumps({"cmd": cmd, "argv": argv, "policy": verdict}))
        return 0
    spawn(argv)
    return 0


def main():
    p = argparse.ArgumentParser(description="Local offline Omarchy assistant")
    p.add_argument("query", nargs="*", help="question to answer")
    p.add_argument("--repl", action="store_true", help="interactive session")
    p.add_argument("--search-daemon", action="store_true",
                   help="read queries on stdin, emit JSON results per line")
    p.add_argument("--explain-section", metavar="SID",
                   help="answer using this section id (skips model navigation)")
    p.add_argument("--chat-daemon", action="store_true",
                   help="conversation mode: JSON requests on stdin, streamed JSON replies")
    p.add_argument("--open-section", metavar="SID",
                   help="open the manual at this section in a floating terminal")
    p.add_argument("--run", metavar="CMD",
                   help="open a floating terminal with CMD pre-filled and editable")
    p.add_argument("--check", metavar="CMD",
                   help="print the execution-policy verdict for CMD as JSON")
    p.add_argument("--print", action="store_true",
                   help="with --open-section/--run: print what would be launched")
    p.add_argument("--popup", action="store_true",
                   help="open the REPL in a floating terminal window")
    p.add_argument("--retrieve-only", action="store_true",
                   help="print the retrieval decision without running the model")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("-v", "--verbose", action="store_true")
    args = p.parse_args()

    if args.popup:
        sys.exit(popup())
    if args.run is not None:
        sys.exit(run_command(args.run, print_only=args.print))
    if args.check is not None:
        v = command_policy(args.check)
        reads, writes = touches(args.check)
        print(json.dumps(dict(cmd=args.check, reads=reads, writes=writes, **v)))
        sys.exit(0 if v["verdict"] != "refuse" else 2)

    if not os.path.exists(DB):
        sys.exit("No index. Run: omarchy-local-agent-index")

    if args.search_daemon:
        search_daemon()
        return
    if args.chat_daemon:
        chat_daemon()
        return
    if args.open_section:
        sys.exit(open_section(args.open_section, print_only=args.print))

    if args.explain_section:
        sys.exit(explain_section(args.explain_section, " ".join(args.query)))

    cfg = load_config()
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)

    if args.repl or not args.query:
        system = build_system()
        repl(db, cfg, system)
        return

    query = " ".join(args.query)

    if args.retrieve_only or args.json:
        res = retrieve(db, query, cfg)
        out = {
            "query": query, "path": res["path"],
            "best_exact": res["best_exact"], "best_section": res["best_section"],
            "binds": [{"keys": b["keys"], "description": b["description"],
                       "score": b["score"]} for b in res["binds"][:3]],
            "commands": [{"route": cm["route"], "summary": cm["summary"],
                          "score": cm["score"]} for cm in res["commands"][:3]],
            "sections": [{"sid": s["sid"], "heading": s["heading"],
                          "source": s["source"], "score": s["score"]}
                         for s in res["sections"][:3]],
        }
        print(json.dumps(out, indent=2))
        return

    answer(db, cfg, query, build_system(), verbose=args.verbose)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
